							"raw": "{\n  \"appVersion\": 18,\n  \"username\": \"{{msisdn}}\",\n  \"pass\": \"7+QEKk8L5/XLlPqLztdIng==\",\n  \"timeStp\": \"04-11-2026 23:13:04.900\",\n  \"device\": \"4f901f73878ec7f5\",\n  \"otherinfo\": \"Xiaomi#22101316C#Redmi Note 12 Pro\",\n  \"hash\": \"5B9CDE4F4F2947129ABD9306EF600054EE859B0DD264690D9A5C5A0805174615\",\n  \"otp\": null,\n  \"rot\": 0,\n  \"dvir\": 1,\n  \"userId\": null\n}",

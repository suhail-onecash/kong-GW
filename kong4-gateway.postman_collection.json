		{
			"name": "Payment Transfer (payment-svc)",
			"description": "Cross-region money transfer orchestrated by the `payment-transfer` plugin: North debit (`/api/debit`) → South credit (`/api/credit`) → status check → reversal on failure (`/api/debit/reverse`).\n\nBody fields: `senderMsisdn` (or `northMsisdn`/`fromMsisdn`), `receiverMsisdn` (or `southMsisdn`/`toMsisdn`), `amount` (> 0), `currency` (default `USD`). Idempotency key from `X-Transaction-Id` header or `transactionId`/`txId` body field; generated UUID otherwise.",
			"item": [
				{
					"name": "Transfer North → South",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Transaction-Id", "value": "tx-{{$timestamp}}" },
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"senderMsisdn\": \"967700000001\",\n  \"receiverMsisdn\": \"967700000002\",\n  \"amount\": {{amount}},\n  \"currency\": \"{{currency}}\",\n  \"transactionId\": \"tx-{{$timestamp}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/payment/transfer",
							"host": ["{{baseUrl}}"],
							"path": ["payment", "transfer"]
						},
						"description": "POST only (405 otherwise). Validates JSON body, dedupes by transaction id via Redis (`tx_ttl_seconds`), then runs debit → credit → status → (reversal on failure)."
					},
					"response": []
				},
				{
					"name": "Transfer (missing fields — validation demo)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": {{amount}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/payment/transfer",
							"host": ["{{baseUrl}}"],
							"path": ["payment", "transfer"]
						},
						"description": "Returns `400 {\"error\":\"Missing senderMsisdn\"}` / `Missing receiverMsisdn` — useful to verify gateway-side validation."
					},
					"response": []
				}
			]
		},
		{

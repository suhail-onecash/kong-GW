		{
			"name": "Switch Account (switch-svc)",
			"description": "Switch Account & Create New Account journeys (plugin priority 960). Reads the passport v2 store `passport:<msisdn>` with `profiles[]` and `deviceDefaults[]`.\n\nActions: `SWITCH`, `CREATE`, `FIRST_TIME_PIN_SETUP`, `SWITCH_AND_REPLACEMENT`, `BLOCKED`. Error codes: `SW_001`–`SW_008`, `REG-ID-012`, `REG-ID-013`, `PIN-017`. See `SWITCH_ACCOUNT_DOCUMENTATION.md`.",
			"item": [
				{
					"name": "Journey Decision",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/switch/decision",
							"host": ["{{baseUrl}}"],
							"path": ["switch", "decision"]
						},
						"description": "Evaluates linked wallets, statuses, PIN state and per-device default; returns the next action. Missing `X-MSISDN` → `REG-ID-001`. Blocked/AML wallet → `403 BLOCKED` (`SW_003`)."
					},
					"response": []
				},
				{
					"name": "Switch — Authenticate to target wallet",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "X-Target-Region", "value": "{{targetRegion}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pin\": \"1234\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/switch/authenticate",
							"host": ["{{baseUrl}}"],
							"path": ["switch", "authenticate"]
						},
						"description": "Routes authentication to the target region backend (`X-Target-Region` = NORTH/SOUTH). Rejects restricted wallets (`SW_003`) and uninitialized PIN (`SW_005`). Injects trusted headers `X-Region`, `X-Account-Id`, `X-Persona`, `X-Passport-Guid`."
					},
					"response": []
				},
				{
					"name": "Set per-device default wallet",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"targetRegion\": \"{{targetRegion}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/switch/set-default",
							"host": ["{{baseUrl}}"],
							"path": ["switch", "set-default"]
						},
						"description": "Persists the per-device preferred wallet (AC-11) into `deviceDefaults[]` in Redis. Success: `{\"status\":true,\"message\":\"Default wallet updated for this device\",...}`."
					},
					"response": []
				},
				{
					"name": "Create second account",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "X-Target-Region", "value": "{{targetRegion}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"KYC payload is owned by the backend; Kong enforces edge guards only\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/switch/create",
							"host": ["{{baseUrl}}"],
							"path": ["switch", "create"]
						},
						"description": "Guarded entry for the second regional wallet. Edge checks: max 2 wallets per MSISDN (`409 REG-ID-012`), opposite-region only (`400 REG-ID-012`), suspended/AML (`403 REG-ID-013`), idempotency lock 10s (`429 PIN-017`)."
					},
					"response": []
				},
				{
					"name": "Journey Decision (NWC path)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/NWC/rest/switch/decision",
							"host": ["{{baseUrl}}"],
							"path": ["NWC", "rest", "switch", "decision"]
						},
						"description": "Alias of `GET /switch/decision` under the `/NWC` prefix (backend-compatible path)."
					},
					"response": []
				},
				{
					"name": "Switch — Authenticate (NWC path)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "X-Target-Region", "value": "{{targetRegion}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pin\": \"1234\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/NWC/rest/switch/authenticate",
							"host": ["{{baseUrl}}"],
							"path": ["NWC", "rest", "switch", "authenticate"]
						},
						"description": "Alias of `POST /switch/authenticate` under the `/NWC` prefix."
					},
					"response": []
				},
				{
					"name": "Set per-device default wallet (NWC path)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"targetRegion\": \"{{targetRegion}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/NWC/rest/switch/set-default",
							"host": ["{{baseUrl}}"],
							"path": ["NWC", "rest", "switch", "set-default"]
						},
						"description": "Alias of `POST /switch/set-default` under the `/NWC` prefix."
					},
					"response": []
				},
				{
					"name": "Create second account (NWC path)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-MSISDN", "value": "{{msisdn}}" },
							{ "key": "X-Device-Id", "value": "{{deviceId}}" },
							{ "key": "X-Target-Region", "value": "{{targetRegion}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"KYC payload is owned by the backend; Kong enforces edge guards only\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/NWC/rest/register/second-account",
							"host": ["{{baseUrl}}"],
							"path": ["NWC", "rest", "register", "second-account"]
						},
						"description": "Alias of `POST /switch/create` under the `/NWC` prefix (`/NWC/rest/register/second-account`)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Kong Admin (localhost:8001)",
			"description": "Admin API is published on port 8001 (`KONG_ADMIN_LISTEN: 0.0.0.0:8001`). Useful for hot-reloading the declarative config and inspecting routes.",
			"item": [
				{
					"name": "Hot-reload declarative config",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "C:/projects/kongs projects/kong4/kong.yml"
								}
							]
						},
						"url": {
							"raw": "http://localhost:8001/config",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8001",
							"path": ["config"]
						},
						"description": "Reload `kong.yml` into the running DB-less gateway without restarting: `POST /config` with the file as multipart form data."
					},
					"response": []
				},
				{
					"name": "List services",
					"request": {
						"method": "GET",
